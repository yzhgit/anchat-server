# =============================================================================
# AnyChat Production Environment (.env.prod)
# =============================================================================
# Copy this file to .env.prod and fill in production values.
# DO NOT commit .env.prod with real credentials!
#
#   cp .env.prod.example .env.prod
#   # Edit .env.prod with production values
#   git add --ignore-errors .env.prod   # (optional: .gitignore it)
# =============================================================================

# ---- Application ----
APP_ENV=prod
GRPC_ADDR=0.0.0.0:50051
HTTP_ADDR=0.0.0.0:8080

# ---- PostgreSQL ----
# Use the internal DNS/hostname of your managed PostgreSQL (RDS, Cloud SQL, etc.)
DB_HOST=<postgresql-host>
DB_PORT=5432
DB_USER=<db-user>
DB_PASSWORD=<db-password>
DB_NAME=im
DB_SSL_MODE=require

# ---- Redis ----
REDIS_ADDR=<redis-host>:6379

# ---- NATS ----
NATS_URL=nats://<nats-host>:4222

# ---- Consul ----
CONSUL_ADDR=<consul-host>:8500

# ---- MinIO (File Service) ----
MINIO_ENDPOINT=<minio-host>:9000
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>

# ---- LiveKit (RTC Service) ----
LIVEKIT_URL=wss://<livekit-host>:7880
LIVEKIT_API_KEY=<livekit-api-key>
LIVEKIT_API_SECRET=<livekit-api-secret>

# ---- JWT Auth ----
JWT_SECRET=<jwt-secret-256-bit>

# ---- Tracing ----
TRACING_ENDPOINT=<jaeger-collector>:4317

# ---- JPush (Push Service) ----
JPUSH_APP_KEY=<jpush-app-key>
JPUSH_MASTER_SECRET=<jpush-master-secret>

# ---- SMS / Email Verification ----
VERIFY_CODE_HASH_SECRET=<verify-code-hash-secret>
VERIFY_DEBUG_FIXED_CODE=
VERIFY_ALLOW_DEV_BYPASS=false

SMS_ACCESS_KEY=<sms-access-key>
SMS_ACCESS_SECRET=<sms-access-secret>
SMS_SIGN_NAME=AnyChat
SMS_TEMPLATE_CODE=<sms-template-code>
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_APP_ID=
TENCENT_TEMPLATE_ID=

EMAIL_HOST=<smtp-host>
EMAIL_PORT=587
EMAIL_USERNAME=<smtp-username>
EMAIL_PASSWORD=<smtp-password>
EMAIL_FROM_NAME=AnyChat
EMAIL_FROM_ADDRESS=noreply@anychat.com