# =============================================================================
# AnyChat Development Environment (.env.dev)
# =============================================================================
# Copy this file to .env.dev and adjust values as needed:
#   cp .env.dev.example .env.dev
#
# Load env vars before running services:
#   set -a; source .env.dev; set +a
#   mage dev:user
# =============================================================================

# ---- Application ----
APP_ENV=dev
GRPC_ADDR=0.0.0.0:50051
HTTP_ADDR=0.0.0.0:8080

# ---- PostgreSQL ----
# When running infrastructure via docker-compose, host should be
# the container's host (localhost on dev machine). If you run Postgres
# locally, adjust accordingly.
DB_HOST=localhost
DB_PORT=5432
DB_USER=anychat
DB_PASSWORD=anychat
DB_NAME=im
DB_SSL_MODE=disable

# ---- Redis ----
REDIS_ADDR=127.0.0.1:6379

# ---- NATS ----
NATS_URL=nats://127.0.0.1:4222

# ---- Consul ----
CONSUL_ADDR=127.0.0.1:8500

# ---- MinIO (File Service) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ---- LiveKit (RTC Service) ----
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---- JWT Auth ----
JWT_SECRET=your-secret-key-change-in-production

# ---- Tracing (Jaeger OTLP gRPC) ----
TRACING_ENDPOINT=127.0.0.1:4317

# ---- JPush (Push Service) ----
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=

# ---- SMS / Email Verification ----
VERIFY_CODE_HASH_SECRET=change-me-for-production
VERIFY_DEBUG_FIXED_CODE=123456
VERIFY_ALLOW_DEV_BYPASS=true

SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
SMS_SIGN_NAME=AnyChat
SMS_TEMPLATE_CODE=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_APP_ID=
TENCENT_TEMPLATE_ID=

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=AnyChat
EMAIL_FROM_ADDRESS=noreply@anychat.com